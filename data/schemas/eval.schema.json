{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/eval.schema.json",
  "title": "CustomerServiceEvalCase",
  "type": "object",
  "additionalProperties": false,
  "required": ["eval_id", "category", "turns", "expected_route", "expected_tools", "forbidden_behaviors", "assertions", "severity"],
  "properties": {
    "eval_id": {"type": "string"},
    "category": {"enum": ["knowledge", "intent_boundary", "case_access", "high_risk", "ticket", "knowledge_quality", "multi_turn", "security"]},
    "actor_user_id": {"type": ["string", "null"]},
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string"}
        }
      }
    },
    "expected_route": {"type": "string"},
    "expected_tools": {"type": "array", "items": {"type": "string"}},
    "forbidden_behaviors": {"type": "array", "items": {"type": "string"}},
    "reference_answer": {"type": ["string", "null"]},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "severity": {"enum": ["normal", "high", "release_blocker"]},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
